# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (notificacion de leads por email)
RESEND_API_KEY=
LEADS_NOTIFY_TO=martin.munoz.padilla1@gmail.com
# Debe ser una dirección del dominio verificado en Resend. `miembros@`
# tiene regla de reenvío en Cloudflare, así que las respuestas sí llegan.
LEADS_NOTIFY_FROM=STRIDE <miembros@stridechile.cl>

# QR rotativo (32 bytes aleatorios o más; solo servidor)
QR_SIGNING_SECRET=

# App
NEXT_PUBLIC_SITE_URL=https://stridechile.cl
NEXT_PUBLIC_ADMIN_URL=https://admin.stridechile.cl
